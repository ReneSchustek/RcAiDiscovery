{
    "name": "ruhrcoder/rc-ai-discovery",
    "description": "Liefert eine optimierte llms.txt aus und prüft, ob die robots.txt die relevanten KI-Crawler zulässt (Shopware 6.7/6.8)",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "version": "0.6.2",
    "authors": [
        {
            "name": "Ruhrcoder",
            "homepage": "https://ruhrcoder.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.7.0 || ~6.8.0",
        "shopware/storefront": "~6.7.0 || ~6.8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "Ruhrcoder\\RcAiDiscovery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruhrcoder\\RcAiDiscovery\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "extra": {
        "shopware-plugin-class": "Ruhrcoder\\RcAiDiscovery\\RcAiDiscovery",
        "label": {
            "de-DE": "KI-Auffindbarkeit (llms.txt & robots.txt)",
            "en-GB": "AI Discovery (llms.txt & robots.txt)"
        },
        "description": {
            "de-DE": "Liefert eine optimierte llms.txt für KI-Systeme aus (automatisch aus Shop-Daten generiert) und prüft, ob die robots.txt die relevanten KI-Crawler zulässt.",
            "en-GB": "Serves an optimised llms.txt for AI systems (auto-generated from shop data) and checks whether robots.txt allows the relevant AI crawlers."
        }
    }
}
